# Copy this file to `.env` and paste in your own Anthropic API key.
# Get one at https://console.anthropic.com  →  API Keys
# `.env` is gitignored — never commit or share it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional (dev only): path to the shared second-brain vault if it is NOT a
# sibling folder. Defaults to ../labour-second-brain.
# LABOUR_VAULT=C:\path\to\labour-second-brain

# --- Build-time only — Cloudflare Pages "build" environment variables ---
# NOT used by `npm run dev`. scripts/export-vault-snapshot.mjs uses these to
# download + bake the vault when no local clone is present (i.e. on Cloudflare).
# GITHUB_TOKEN is a read-only fine-grained PAT scoped to the vault repo only.
# VAULT_REPO=newera2040/labour-second-brain
# VAULT_REF=main
# GITHUB_TOKEN=github_pat_xxx
